# Copie para .env.local e preencha. O .env.local é ignorado pelo git —
# nenhuma chave real deve voltar para este arquivo.
#
#   cp .env.example .env.local

# ---------------------------------------------------------------------------
# Supabase — obrigatório
# ---------------------------------------------------------------------------
# Sem estes dois o site sobe, mas as modalidades ficam todas em "Em breve":
# preço e link de pagamento vêm da tabela lotes_encontro27.
# A anon key é pública por natureza (roda no navegador, protegida por RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# API de checkout — obrigatório para concluir uma compra
# ---------------------------------------------------------------------------
# Quem responde POST /criar-checkout e gera o link de pagamento na Hypercash.
# Em produção: https://api.oencontropi.com.br
# Em desenvolvimento, use o proxy (veja o README): http://localhost:3001
NEXT_PUBLIC_API_URL=

# ---------------------------------------------------------------------------
# Opcionais do front
# ---------------------------------------------------------------------------
# Usado em metadata, sitemap.xml, robots.txt e no JSON-LD do evento.
NEXT_PUBLIC_SITE_URL=

# Google Tag Manager. Em branco, nenhum script de tracking é carregado.
NEXT_PUBLIC_GTM_ID=

# ---------------------------------------------------------------------------
# Somente server-side — NUNCA prefixar com NEXT_PUBLIC_
# ---------------------------------------------------------------------------
# Ignora o RLS: quem tem esta chave lê e escreve qualquer tabela.
# Usada por scripts/seed-admin.mjs e pela API em api/.
SUPABASE_SERVICE_ROLE_KEY=

# A API em api/ lê SUPABASE_URL, e não NEXT_PUBLIC_SUPABASE_URL — mesmo valor,
# nome diferente. Sem esta linha, `npm run dev` dentro de api/ sobe e só falha
# na primeira requisição.
SUPABASE_URL=

# Origens que a API aceita no CORS, separadas por vírgula. Para rodar a API
# local junto do site: http://localhost:3000
CORS_ALLOWED_ORIGINS=

# Porta da API local. Padrão 3000, que conflita com o next dev — use outra.
PORT=3002

# Chave secreta da Hypercash (Integrações > API de Produtos e Pagamentos).
# Só a API usa; cria cobrança em nome do evento, então jamais no navegador.
HYPERCASH_PRODUCTS_API_KEY=

# Segredo do webhook. A Hypercash não assina os requests, então quem
# autentica a chamada é este valor na própria URL registrada lá:
#   https://api.oencontropi.com.br/webhooks/hypercash/<este-valor>
# Gere um aleatório e longo: openssl rand -hex 32
HYPERCASH_WEBHOOK_SECRET=
